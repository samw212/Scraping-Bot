# Optional fine-grained Gluetun control-server auth.
# Copy to gluetun/auth/config.toml, mount it at /gluetun/auth/config.toml in
# each gluetun service, and drop HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE.
# scrapebot needs exactly these routes:

[[roles]]
name = "scrapebot"
routes = [
  "GET /v1/publicip/ip",
  "GET /v1/vpn/status",
  "PUT /v1/vpn/status",
]
auth = "apikey"
apikey = "REPLACE_WITH_THE_SAME_VALUE_AS_GLUETUN_API_KEY"
