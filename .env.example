# ---- VPN provider (see https://github.com/qdm12/gluetun-wiki for your provider)
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# For OpenVPN providers instead:
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# Server pool per container: each container exits from a different region.
# On rotation Gluetun picks a new server within these filters.
GLUETUN_1_COUNTRIES=United States
GLUETUN_2_COUNTRIES=Canada
GLUETUN_3_COUNTRIES=United Kingdom

# ---- Gluetun control server API key (generate: docker run --rm qmcgaw/gluetun genkey)
GLUETUN_API_KEY=

# ---- Credentials for Gluetun's HTTP proxy (recommended even on a private network)
GLUETUN_PROXY_USER=scrapebot
GLUETUN_PROXY_PASSWORD=

# 1 = headful Chromium under Xvfb (recommended), 0 = headless
HEADFUL=1
